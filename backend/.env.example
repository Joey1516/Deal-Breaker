APIFY_TOKEN=your_apify_api_token_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
PORT=8787

# OAuth Client ID from Google Cloud Console (Credentials -> OAuth 2.0 Client IDs).
# Leave unset to keep Google Sign-In disabled (the route 503s without it).
GOOGLE_CLIENT_ID=

# Comma-separated list of frontend origins allowed to call this API.
# Add your production frontend URL here once deployed, e.g.:
# ALLOWED_ORIGINS=http://localhost:5180,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5180,http://localhost:5173
